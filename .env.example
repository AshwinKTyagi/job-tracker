# Copy to .env and edit. Real environment variables override these.
# .env is gitignored; .env.example is not.

# Classifier backend: "rules" (default, offline) or "ollama" (local LLM, rules fallback).
JOBTRACK_CLASSIFY_BACKEND=ollama

# Ollama model tag. Resolved to a digest at startup and recorded in classifier_version.
JOBTRACK_OLLAMA_MODEL=qwen2.5:7b

# Ollama daemon.
JOBTRACK_OLLAMA_HOST=http://localhost:11434

# Below this confidence a verdict is flagged for `jobtrack review`.
JOBTRACK_MIN_CONFIDENCE=0.60
